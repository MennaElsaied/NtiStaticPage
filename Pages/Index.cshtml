
@page
@model IndexModel
@{
    ViewData["Title"] = "NTI | Web Development";
}

<style>
    * {
        box-sizing: border-box;
    }

    .nti-page {
        font-family: 'Segoe UI', sans-serif;
        color: #17233f;
        overflow: hidden;
    }

    .nti-hero {
        min-height: 570px;
        padding: 85px 8%;
        display: flex;
        align-items: center;
        background: linear-gradient(120deg, #101b3b, #243b75, #5144a5);
        color: white;
        position: relative;
        isolation: isolate;
    }

    .nti-hero::before {
        content: "";
        position: absolute;
        width: 400px;
        height: 400px;
        background: #6c63ff;
        opacity: .2;
        filter: blur(100px);
        border-radius: 50%;
        right: -100px;
        top: -100px;
        z-index: -1;
    }

    .nti-hero::after {
        content: "";
        position: absolute;
        width: 350px;
        height: 350px;
        background: #00c6ff;
        opacity: .15;
        filter: blur(100px);
        border-radius: 50%;
        left: 10%;
        bottom: -150px;
        z-index: -1;
    }

    .nti-content {
        max-width: 650px;
        animation: fadeUp 1s ease;
    }

    .nti-label {
        display: inline-block;
        padding: 9px 18px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 30px;
        font-size: 13px;
        letter-spacing: 2px;
        margin-bottom: 25px;
    }

    .nti-content h1 {
        font-size: clamp(38px, 5vw, 65px);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 22px;
    }

    .nti-content h1 span {
        color: #8ddcff;
    }

    .nti-content p {
        color: #d2dcf4;
        font-size: 17px;
        line-height: 1.9;
        max-width: 550px;
    }

    .nti-btn {
        display: inline-block;
        margin-top: 25px;
        padding: 14px 30px;
        border-radius: 10px;
        background: linear-gradient(90deg, #55c7f5, #8a78ff);
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .3s;
    }

    .nti-btn:hover {
        transform: translateY(-5px);
        color: white;
        box-shadow: 0 10px 30px rgba(85,199,245,.3);
    }

    .nti-image {
        width: 43%;
        margin-left: 5%;
        animation: floatImage 4s ease-in-out infinite;
    }

    .nti-image img {
        width: 100%;
        border-radius: 25px;
        border: 1px solid rgba(255,255,255,.2);
        box-shadow: 0 25px 70px rgba(0,0,0,.3);
    }

    .nti-section {
        padding: 85px 8%;
        text-align: center;
        background: #f7f9ff;
    }

    .nti-section-title {
        font-size: 34px;
        font-weight: 800;
        color: #172c55;
        margin-bottom: 15px;
    }

    .nti-section-desc {
        color: #78849a;
        margin-bottom: 45px;
        font-size: 16px;
    }

    .nti-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .nti-card {
        background: white;
        padding: 35px 25px;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(35,55,100,.06);
        border: 1px solid #edf0f8;
        transition: .35s;
    }

    .nti-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 18px 40px rgba(60,80,160,.12);
    }

    .nti-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: #edf2ff;
        font-size: 30px;
        margin: 0 auto 22px;
    }

    .nti-card h3 {
        color: #243b75;
        font-size: 21px;
        font-weight: 750;
        margin-bottom: 15px;
    }

    .nti-card p {
        color: #78849a;
        line-height: 1.8;
        font-size: 14px;
    }

    .nti-about {
        padding: 75px 8%;
        background: white;
        text-align: center;
    }

    .nti-about-box {
        background: linear-gradient(120deg, #17284e, #354e91);
        padding: 55px 25px;
        border-radius: 22px;
        color: white;
    }

    .nti-about-box h2 {
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .nti-about-box p {
        max-width: 700px;
        margin: auto;
        color: #d5def4;
        line-height: 1.9;
    }

    .nti-footer {
        background: #101b35;
        padding: 25px;
        text-align: center;
        color: #b7c3dc;
        font-size: 14px;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(35px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatImage {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-13px);
        }
    }

    @@media (max-width: 850px) {
        .nti-hero {
            flex-direction: column;
            text-align: center;
            padding: 65px 6%;
        }

        .nti-content p {
            margin: auto;
        }

        .nti-image {
            width: 85%;
            margin: 50px 0 0;
        }

        .nti-cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 550px) {
        .nti-cards {
            grid-template-columns: 1fr;
        }

        .nti-section-title {
            font-size: 27px;
        }

        .nti-image {
            width: 100%;
        }
    }
</style>

<div class="nti-page">

    <!-- HERO SECTION -->
    <section class="nti-hero">

        <div class="nti-content">

            <span class="nti-label">
                NTI TRAINING PROJECT
            </span>

            <h1>
                Welcome To
                <span>Web Development</span>
            </h1>

            <p>
                Discover the world of modern web development.
                Building creative, responsive and user-friendly
                websites using the latest web technologies.
            </p>

            <a href="#technologies" class="nti-btn">
                Explore More →
            </a>

        </div>

        <div class="nti-image">
            <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=900&q=85"
                 alt="Modern Web Development Workspace" />
        </div>

    </section>


    <!-- TECHNOLOGIES SECTION -->
    <section class="nti-section" id="technologies">

        <h2 class="nti-section-title">
            Technologies We Use
        </h2>

        <p class="nti-section-desc">
            The essential technologies behind modern websites.
        </p>

        <div class="nti-cards">

            <div class="nti-card">
                <div class="nti-icon">🌐</div>
                <h3>HTML5</h3>
                <p>
                    Build structured and meaningful web pages
                    using modern HTML elements.
                </p>
            </div>

            <div class="nti-card">
                <div class="nti-icon">🎨</div>
                <h3>CSS3</h3>
                <p>
                    Create beautiful layouts, animations,
                    colors and responsive designs.
                </p>
            </div>

            <div class="nti-card">
                <div class="nti-icon">⚡</div>
                <h3>JavaScript</h3>
                <p>
                    Add interactivity and dynamic behavior
                    to modern web applications.
                </p>
            </div>

        </div>

    </section>


    <!-- ABOUT SECTION -->
    <section class="nti-about">

        <div class="nti-about-box">

            <h2>Turning Ideas Into Reality</h2>

            <p>
                This project demonstrates the fundamentals
                of static website development using
                ASP.NET Core Razor Pages, HTML and CSS.
                Our goal is to create a simple, elegant
                and responsive web experience.
            </p>

        </div>

    </section>


    <!-- FOOTER -->
    <footer class="nti-footer">
        <p>
            © 2026 NTI Web Development Project.
            All Rights Reserved.
        </p>
    </footer>

</div>
